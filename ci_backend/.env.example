# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=competitive_intelligence

# Auth (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret-min-16-chars

# OpenAI
OPENAI_API_KEY=

# Reports (Gamma PDF)
GAMMA_API_KEY=
GAMMA_API_URL=

# CORS: comma-separated frontend origins (no trailing slash). Required when frontend and API are on different hosts.
# Local dev (frontend :8080, API :8000):
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Production example:
# CORS_ORIGINS=https://app.yourcompany.com

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public URL of this API (used for links to uploaded files)
PUBLIC_BASE_URL=http://localhost:8000

# Email (optional — SendGrid or SMTP)
SENDGRID_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

PROFILE_UPLOAD_DIR=uploads/profile_photos
